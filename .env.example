# Copie ce fichier en `.env.local` pour le développement local, et reporte les mêmes valeurs
# dans Vercel (Project Settings → Environment Variables) pour la prod. Voir SETUP.md.

# --- Supabase (base de données partagée) ---
# Project Settings → API, dans le dashboard Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clé "service_role" (jamais exposée au frontend) — utilisée uniquement par les fonctions
# serverless dans api/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (compte crm.flashimpression@gmail.com) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendrier cible pour les évènements de planification. "primary" = calendrier principal
# du compte crm.flashimpression@gmail.com.
GOOGLE_CALENDAR_ID=primary
# ID du Google Sheet (dans son URL : https://docs.google.com/spreadsheets/d/<ID>/edit),
# avec un onglet nommé "Dossiers" et partagé en édition avec crm.flashimpression@gmail.com.
GOOGLE_SHEET_ID=
# Optionnel — dossier Drive où ranger les pièces jointes des fiches. Laisse vide pour les mettre
# à la racine du Drive de crm.flashimpression@gmail.com (le scope drive.file ne permet d'écrire
# dans un dossier existant que si ce dossier a lui-même été créé par l'app).
GOOGLE_DRIVE_FOLDER_ID=

# --- Rappel quotidien (cron) ---
# Destinataire du récap 8h30. Par défaut : crm.flashimpression@gmail.com lui-même.
RAPPEL_DESTINATAIRE=crm.flashimpression@gmail.com
# Valeur aléatoire de ton choix, à définir aussi dans Vercel — protège /api/cron/* contre un
# déclenchement par n'importe qui connaissant l'URL.
CRON_SECRET=
